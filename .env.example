# ---------- Shared ----------
NODE_ENV=development

# ---------- Database (packages/db, apps/api) ----------
DATABASE_URL="postgresql://chs:chs_dev_password@localhost:5432/chs_portal?schema=public"

# ---------- API (apps/api) ----------
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Session / JWT
JWT_SECRET="replace-with-a-long-random-string-in-production"
SESSION_TTL_HOURS=12

# Local dev auth fallback. Set to "true" to allow email/password login
# (seeded users) instead of / in addition to Entra ID SSO. Always true
# until Entra ID app registration below is filled in for a given tenant.
ALLOW_PASSWORD_LOGIN=true

# ---------- Microsoft Entra ID (Azure AD) SSO ----------
# Fill these in per-tenant to enable "Sign in with Microsoft" on the
# three login routes. See apps/api/src/routes/auth.ts for the OIDC
# authorization-code flow this feeds. Leave blank in local dev.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI="http://localhost:4000/auth/entra/callback"

# ---------- Microsoft Teams integration ----------
# Incoming Webhook URL for the "CHS - Time Logs" channel (Manager+Admin
# members only). Leave blank to no-op the Teams post (it will be logged
# to the AuditLog as a skipped/failed delivery instead of blocking).
TEAMS_WEBHOOK_URL=
# Optional: base URL used to build the "View in Portal" deep link in the
# Adaptive Card sent to Teams.
PORTAL_BASE_URL="http://localhost:3000"

# ---------- File storage ----------
# "local" uses apps/api/../../storage on disk with signed, expiring
# tokenized URLs (see apps/api/src/utils/storage.ts). Swap to "s3" and
# fill in the bucket/creds once an S3-compatible bucket is provisioned;
# the adapter interface is already S3-shaped.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="../../storage"
STORAGE_SIGNED_URL_TTL_MINUTES=10

# S3 (only used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
